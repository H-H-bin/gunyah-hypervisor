// Feature bits
define VIRTIO_BLK_F_CONFIG_WCE constant type count_t = 11;

extend virtio_backend object {
	virtio		structure virtio(contained);
	virq_source	structure virq_source(contained);
	flags		bitfield virtio_backend_option_flags;

	vqs_bitmap	type register_t(atomic);
	reason		bitfield virtio_backend_notify_reason(atomic);
};

extend virq_trigger enumeration {
	virtio_backend;
};

extend virtio_backend_type enumeration {
	hypercall;
};
