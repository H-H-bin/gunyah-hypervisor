extend vpm_group object {
	options		bitfield vpm_group_option_flags;
	vm_on		bool(atomic);
};

#if defined(PLATFORM_ENABLE_SYSTEM_SUSPEND) && PLATFORM_ENABLE_SYSTEM_SUSPEND
// This flag indicates that the vpm_group controls entry into the platform
// suspend-to-ram power state
extend vpm_group object {
	power_system_suspend	bool;
};
#endif // PLATFORM_ENABLE_SYSTEM_SUSPEND

// This flag indicates power state threshold of the vpm_group
extend vpm_group object {
	power_state_threshold	bitfield psci_suspend_powerstate;
};

define vpm_mode enumeration {
	NONE = 0;
	IDLE;
};

extend thread object {
	vpm_mode	enumeration vpm_mode;
};
