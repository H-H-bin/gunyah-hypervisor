module virtio_mmio

subscribe virtio_startup[VIRTIO_TRANSPORT_TYPE_MMIO](virtio)

subscribe virtio_shutdown[VIRTIO_TRANSPORT_TYPE_MMIO](virtio)

subscribe virtio_ack_features_ok[VIRTIO_TRANSPORT_TYPE_MMIO](virtio)

subscribe virtio_config_update_begin[VIRTIO_TRANSPORT_TYPE_MMIO](virtio)

subscribe virtio_config_update_end[VIRTIO_TRANSPORT_TYPE_MMIO](virtio)

subscribe virtio_queue_ready[VIRTIO_TRANSPORT_TYPE_MMIO](virtio, vq)

subscribe virtio_reset_complete[VIRTIO_TRANSPORT_TYPE_MMIO](virtio)
	require_spinlock(virtio->status_lock)

subscribe virq_check_pending[VIRQ_TRIGGER_VIRTIO_MMIO_FRONTEND]
	handler virtio_mmio_frontend_handle_virq_check_pending(source)

subscribe vdevice_access[VDEVICE_TYPE_VIRTIO_MMIO](
		vdevice, offset, access_size, value, is_write)
	// This should be release_rcu_read.
	// FIXME:
	require_rcu_read
