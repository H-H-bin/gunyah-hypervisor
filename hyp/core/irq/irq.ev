module irq

subscribe boot_cold_init()
	// Ensure we run before any interrupt controller drivers
	priority 1

subscribe object_create_hwirq
	priority last

subscribe object_activate_hwirq
	// Run last so the IRQ is not inserted in the global table prematurely
	priority last

subscribe object_deactivate_hwirq
	priority first

subscribe irq_dispatch[IRQ_RANGE_TYPE_HWIRQ](irq, range, offset)
	require_rcu_read
	require_preempt_disabled
