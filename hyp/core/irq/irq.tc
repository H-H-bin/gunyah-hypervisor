extend irq_range structure {
	node		structure range_tree_node(contained);
	range_type	enumeration irq_range_type;
};

extend hwirq object {
	is_bound	bool(atomic, group(flags));
	irq		type irq_t;
	action		enumeration hwirq_action;
	opaque		uint64;
};

extend hwirq_create structure {
	irq	type irq_t;
	action	enumeration hwirq_action;
	opaque	uint64;
};

define hwirq_action enumeration {
	ignore;
};

extend irq_range_type enumeration {
	hwirq;
};

define irq_range_hwirq structure {
	range		structure irq_range(contained);
	hwirqs		pointer pointer(atomic) object hwirq;
};
