#if defined(INTERFACE_VCPU) && defined(ARCH_ARM_FEAT_FGT) && ARCH_ARM_FEAT_FGT
extend vcpu_el2_registers structure {
	hfgwtr_el2	bitfield HFGWTR_EL2;
};
