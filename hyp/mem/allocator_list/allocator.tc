define allocator_node structure {
	size size;
	next pointer structure allocator_node;
};

define allocator_list structure {
	heap pointer structure allocator_node;
	lock structure spinlock;
	total_size size;
	alloc_size size;
};

extend allocator structure {
	hyp structure allocator_list;
#if defined(PLATFORM_ALLOCATOR_S2PT_HEAP)
	s2pt structure allocator_list;
#endif
};
