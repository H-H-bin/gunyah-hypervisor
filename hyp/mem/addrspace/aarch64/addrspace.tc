#if defined(INTERFACE_VCPU_RUN)
extend scheduler_block enumeration {
	addrspace_fault_access;
};

extend thread object module addrspace {
	fault_access_ipa	type vmaddr_t;
	fault_access_size	size;
	fault_access_value	uregister;
	fault_access_type	enumeration addrspace_access_type;
	fault_access_vmmio	bool;
	fault_access_is_mapped	bool;
};
