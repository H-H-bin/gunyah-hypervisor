module range_map_gpt

subscribe range_map_values_equal[RANGE_MAP_TYPE_EMPTY]
	handler range_map_gpt_handle_empty_values_equal()

subscribe range_map_walk_callback[RANGE_MAP_CALLBACK_RESERVED]
	handler range_map_gpt_handle_reserved_callback() noreturn

subscribe rcu_update[RCU_UPDATE_CLASS_RANGE_MAP_FREE_LEVEL]
	handler range_map_gpt_handle_rcu_free_level(entry)

#if defined(UNIT_TESTS)
subscribe tests_init

subscribe tests_start

subscribe range_map_value_add_offset[RANGE_MAP_TYPE_TEST_A, RANGE_MAP_TYPE_TEST_B, RANGE_MAP_TYPE_TEST_C]
	handler range_map_tests_add_offset

subscribe range_map_values_equal[RANGE_MAP_TYPE_TEST_A, RANGE_MAP_TYPE_TEST_B, RANGE_MAP_TYPE_TEST_C]
	handler range_map_tests_values_equal(x, y)

subscribe range_map_walk_callback[RANGE_MAP_CALLBACK_TEST]
	handler range_map_tests_callback(entry, base, size, arg)
#endif
