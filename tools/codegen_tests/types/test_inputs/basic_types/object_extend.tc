// ============================================================================
// Object Extensions - Module-Specific Fields
// ============================================================================

// Extend ExecContext object
// Adds additional character fields to the base ExecContext object definition
extend ExecContext object module Machine {
	e	char;		// Character field for Machine module
	f	char;		// Character field for Machine module
};

